{
  "name": "wincleanerlamp",
  "version": "2.7.0",
  "private": true,
  "description": "Очистка временных файлов и кешей: ядра на Go для Windows, Linux и macOS и GUI на Electron.",
  "license": "MIT",
  "author": "Danik Off",
  "repository": {
    "type": "git",
    "url": "https://github.com/suzen/wincleanerlamp.git"
  },
  "scripts": {
    "version": "node scripts/sync-gui-version.js",
    "build": "go build -o win-cleaner-lamp.exe ./wincli",
    "build:linux": "go build -o lin-cleaner-lamp ./lincli",
    "build:mac": "go build -o mac-cleaner-lamp ./maccli",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\"",
    "release:push": "git push --follow-tags"
  }
}
